#the mod name as displayed in-game
displayName: No Limit Schematic Size"

#the internal name of your mod
name: "No Limit Schematic Size"

#your name
author: "teong_geuri"

#the fully qualified main class of the mod
main: "NoLimitSchematicSize.NoLimitSchematicSizeMod"

#the mod description as seen in the mod dialog
description: "게임 시작 시(세션당 정확히 1회) 스테이징 폴더의 대형 설계도를 128x128 제한 없이 읽어 schematics 목록에 등록합니다."

#the mod version
version: 1.0.0

#the minimum game build required to run this mod
minGameVersion: 160.1

#this is a java mod
java: true

#hide from multiplayer mod list; this mod must stay client-side/render-only
hidden: true
